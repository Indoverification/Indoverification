PORT=10000
DATABASE_URL=postgresql://user:password@host:5432/database
PGSSL=true
JWT_SECRET=replace-with-a-long-random-secret
# Shared Zoho Mail API sender used by every registered app.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_MAIL_API_URL=https://mail.zoho.in
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_ACCOUNT_ID=your-zoho-mail-account-id
ZOHO_FROM=indogroup@zohomail.in
MAIL_API_TIMEOUT_MS=15000
CORS_ORIGIN=https://indomark.github.io
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Indoone Firebase Admin credentials used to mint a Firebase session after a successful email OTP login.
FIREBASE_INDOONE_PROJECT_ID=your-firebase-project-id
FIREBASE_INDOONE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_INDOONE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
